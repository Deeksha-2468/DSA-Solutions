class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int n=prices.size();
        int buyPrice=prices[0];
        int maxProfitv=0;
        int currProfit;
        for(int i=1;i<n;i++){
            if(prices[i]<buyPrice){
                buyPrice=prices[i];
            }
            currProfit=prices[i]-buyPrice;
            maxProfitv=max(currProfit, maxProfitv);
        }
        return maxProfitv;
    }
};
